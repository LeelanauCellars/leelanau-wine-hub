# Leave blank when Central is hosted at its own origin (for example central.lwc.wine).
# Use /central if the app is reverse-proxied beneath https://lwc.wine/central.
NEXT_PUBLIC_CENTRAL_PATH_PREFIX=

# Ask Central (optional override; Vercel AI Gateway uses project OIDC when deployed)
ASK_CENTRAL_MODEL=openai/gpt-5.6-luna
# For local development only, you can optionally use an AI Gateway API key:
# AI_GATEWAY_API_KEY=
