# Commerce7 private app credentials. Keep the secret server-side only.
COMMERCE7_APP_ID=
COMMERCE7_APP_SECRET=
COMMERCE7_TENANT_ID=

# Optional Wine Hub role-based PIN access. It is OFF by default during development.
# Later, set WINE_HUB_PIN_ACCESS=true and configure the secret + all three PINs.
WINE_HUB_PIN_ACCESS=false
WINE_HUB_AUTH_SECRET=
WINE_HUB_ADMIN_PIN=
WINE_HUB_SALES_PIN=
WINE_HUB_TASTING_PIN=

# Optional: connect Vercel Blob if Admin should replace the official
# Tasting Room Menu PDF from inside Wine Hub without a code deployment.
# A Vercel Blob integration can provide these automatically.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
