# Leave blank when Central is hosted at its own origin (for example central.lwc.wine).
# Use /central if the app is reverse-proxied beneath https://lwc.wine/central.
NEXT_PUBLIC_CENTRAL_PATH_PREFIX=

# Ask Central — direct Google Gemini API
# Keep this server-side in Vercel; never expose it with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional model override. Gemini 3.5 Flash supports the Gemini API free tier.
ASK_CENTRAL_GEMINI_MODEL=gemini-3.5-flash

# Optional fallback if the primary model is overloaded or temporarily unavailable.
ASK_CENTRAL_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
